# Alianza Search Readiness Scanner — Environment Variables
# Copy this file to .env and fill in your values

# Supabase (Required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here

# OpenAI (Optional — enables E-E-A-T analysis and SERP query generation)
OPENAI_API_KEY=

# ValueSerp (Optional — enables SERP ranking checks)
VALUESERP_API_KEY=

# Google PageSpeed Insights (Optional — enables performance metrics)
GOOGLE_PSI_API_KEY=
